{
  "config": {
    "flow_title": "TerraMow ({host})",
    "step": {
      "user": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "user_pass": {
        "title": "TerraMow",
        "description": "Discovered TerraMow at {host}. Enter the MQTT password to complete setup.",
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "reauth_confirm": {
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "reconfigure": {
        "title": "Reconfigure TerraMow",
        "description": "Update the IP address / hostname or password of your TerraMow.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "TerraMow options",
        "data": {
          "map_resolution": "Map output resolution (px)",
          "map_theme": "Map theme",
          "map_show_coverage": "Show mowed coverage",
          "assume_job_complete": "Treat every finished job as 100 % complete"
        },
        "data_description": {
          "map_resolution": "Output side length of the map camera PNG. Higher values give a sharper image when embedded in dashboards but increase bandwidth and CPU on each render.",
          "map_theme": "Color theme of the rendered map camera image. \"dark\" matches dark dashboards.",
          "map_show_coverage": "Shade the already mowed area at the real cutting width underneath the path line.",
          "assume_job_complete": "Some firmware ends a finished job without a completion signal, so the session progress never snaps to 100 %. Turn this on to treat any finished job as complete (100 %), matching the app; leave it off to keep the honest counter value."
        }
      }
    }
  },
