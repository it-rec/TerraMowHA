  "issues": {
    "firmware_ha_module_too_low": {
      "title": "TerraMow firmware update required",
      "description": "The TerraMow's firmware HA module version ({firmware_version}) is too old for this integration, which needs version {required_version}. Update the mower firmware from the TerraMow app to restore full functionality."
    },
    "firmware_overall_too_low": {
      "title": "TerraMow firmware update required",
      "description": "The TerraMow's firmware is older than the minimum supported version ({required_version}). Update the mower firmware from the TerraMow app to use this integration."
    },
    "firmware_incompatible": {
      "title": "TerraMow firmware incompatible",
      "description": "The integration could not confirm the TerraMow's firmware is compatible. Check that both the mower firmware and this integration are up to date, then download the diagnostics and open an issue if the problem persists."
    },
    "plugin_downgrade_recommended": {
      "title": "TerraMow integration update recommended",
      "description": "The TerraMow's firmware HA module version ({firmware_version}) is newer than this integration supports ({plugin_version}). Update the integration in HACS to get the latest features."
    },
    "blade_maintenance_due": {
      "title": "TerraMow blade maintenance due",
      "description": "The TerraMow's blade disc has run for its recommended {hours}-hour service interval. Clean or replace the blades, then reset the blade timer with the \"Reset Blade Timer\" button to clear this reminder."
    },
    "base_station_maintenance_due": {
      "title": "TerraMow base station maintenance due",
      "description": "The TerraMow's base station has run for its recommended {days}-day service interval. Clean the base station, then reset the base station timer with the \"Reset Base Station Timer\" button to clear this reminder."
    }
  },
  "exceptions": {
    "command_not_delivered": {
      "message": "Couldn't send the command to the mower — it is offline or unreachable over MQTT. Check that the mower is powered on and connected to the network, then try again."
    },
    "command_rate_limited": {
      "message": "Another command was just sent to the mower. Please wait a moment and try again."
    },
    "command_rejected": {
      "message": "The mower rejected the command (error code {code})."
    },
    "entity_not_registered": {
      "message": "{entity_id} is not a registered TerraMow entity."
    },
    "lawn_mower_not_ready": {
      "message": "The TerraMow lawn mower for {entity_id} is not ready yet."
    },
    "schedule_item_not_found": {
      "message": "No schedule slot with item id {item_id} exists on the mower."
    },
    "schedule_write_failed": {
      "message": "The mower did not accept the schedule change (attempts: {attempts}). Current TerraMow firmware does not accept schedule writes over the local network - the vendor app uses Bluetooth/cloud instead. Use the weather-adaptive mowing blueprint for scheduling from Home Assistant; these services will work once firmware adds local write support."
    },
    "advanced_setting_write_failed": {
      "message": "The mower did not apply the {setting} setting. Current firmware may not accept advanced-setting writes over local MQTT (attempts: {attempts})."
    }
  }
}
