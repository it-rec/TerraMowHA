  "issues": {
    "firmware_ha_module_too_low": {
      "title": "Aggiornamento firmware TerraMow richiesto",
      "description": "La versione del modulo HA nel firmware TerraMow ({firmware_version}) è troppo vecchia per questa integrazione, che richiede la versione {required_version}. Aggiorna il firmware del rasaerba dall'app TerraMow per ripristinare tutte le funzionalità."
    },
    "firmware_overall_too_low": {
      "title": "Aggiornamento firmware TerraMow richiesto",
      "description": "Il firmware TerraMow è più vecchio della versione minima supportata ({required_version}). Aggiorna il firmware del rasaerba dall'app TerraMow per utilizzare questa integrazione."
    },
    "firmware_incompatible": {
      "title": "Firmware TerraMow incompatibile",
      "description": "L'integrazione non è riuscita a confermare che il firmware TerraMow sia compatibile. Verifica che sia il firmware del rasaerba sia questa integrazione siano aggiornati, quindi scarica la diagnostica e apri una segnalazione se il problema persiste."
    },
    "plugin_downgrade_recommended": {
      "title": "Aggiornamento dell'integrazione TerraMow consigliato",
      "description": "La versione del modulo HA nel firmware TerraMow ({firmware_version}) è più recente di quella supportata da questa integrazione ({plugin_version}). Aggiorna l'integrazione in HACS per ottenere le funzionalità più recenti."
    },
    "blade_maintenance_due": {
      "title": "Manutenzione delle lame TerraMow necessaria",
      "description": "Il disco lame del TerraMow ha raggiunto l'intervallo di manutenzione consigliato di {hours} ore. Pulisci o sostituisci le lame, quindi reimposta il timer delle lame per cancellare questo promemoria."
    },
    "base_station_maintenance_due": {
      "title": "Manutenzione della stazione base TerraMow necessaria",
      "description": "La stazione base del TerraMow ha raggiunto l'intervallo di manutenzione consigliato di {days} giorni. Pulisci la stazione base, quindi reimposta il timer della stazione base per cancellare questo promemoria."
    }
  },
