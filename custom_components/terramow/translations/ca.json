    },
    "firmware_overall_too_low": {
      "title": "Cal actualitzar el firmware de TerraMow",
      "description": "El firmware de TerraMow és més antic que la versió mínima admesa ({required_version}). Actualitza el firmware de la gespadora des de l'aplicació TerraMow per utilitzar aquesta integració."
    },
    "firmware_incompatible": {
      "title": "Firmware de TerraMow incompatible",
      "description": "La integració no ha pogut confirmar que el firmware de TerraMow sigui compatible. Comprova que tant el firmware de la gespadora com aquesta integració estiguin actualitzats, després baixa els diagnòstics i obre una incidència si el problema continua."
    },
    "plugin_downgrade_recommended": {
      "title": "Es recomana actualitzar la integració TerraMow",
      "description": "La versió del mòdul HA del firmware de TerraMow ({firmware_version}) és més nova del que admet aquesta integració ({plugin_version}). Actualitza la integració a HACS per obtenir les darreres funcions."
    },
    "blade_maintenance_due": {
      "title": "Manteniment de les fulles del TerraMow pendent",
      "description": "El disc de fulles del TerraMow ha assolit l'interval de servei recomanat de {hours} hores. Netegeu o substituïu les fulles i, tot seguit, reinicieu el temporitzador de les fulles per esborrar aquest recordatori."
    },
    "base_station_maintenance_due": {
      "title": "Manteniment de l'estació base del TerraMow pendent",
      "description": "L'estació base del TerraMow ha assolit l'interval de servei recomanat de {days} dies. Netegeu l'estació base i, tot seguit, reinicieu el temporitzador de l'estació base per esborrar aquest recordatori."
    }
  },
