  "issues": {
    "firmware_ha_module_too_low": {
      "title": "TerraMow ファームウェアの更新が必要です",
      "description": "TerraMow ファームウェアの HA モジュールバージョン ({firmware_version}) は、このインテグレーションが必要とするバージョン {required_version} に対して古すぎます。すべての機能を回復するには、TerraMow アプリから芝刈り機のファームウェアを更新してください。"
    },
    "firmware_overall_too_low": {
      "title": "TerraMow ファームウェアの更新が必要です",
      "description": "TerraMow ファームウェアが最低対応バージョン ({required_version}) より古いです。このインテグレーションを使用するには、TerraMow アプリから芝刈り機のファームウェアを更新してください。"
    },
    "firmware_incompatible": {
      "title": "TerraMow ファームウェアが非対応です",
      "description": "インテグレーションは TerraMow ファームウェアの互換性を確認できませんでした。芝刈り機のファームウェアとこのインテグレーションの両方が最新であることを確認し、問題が続く場合は診断情報をダウンロードして issue を作成してください。"
    },
    "plugin_downgrade_recommended": {
      "title": "TerraMow インテグレーションの更新を推奨します",
      "description": "TerraMow ファームウェアの HA モジュールバージョン ({firmware_version}) は、このインテグレーションが対応するバージョン ({plugin_version}) より新しいです。最新機能を利用するには、HACS でインテグレーションを更新してください。"
    }
