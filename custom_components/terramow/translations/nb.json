    },
    "blade_maintenance_due": {
      "title": "Vedlikehold av TerraMow-kniver kreves",
      "description": "TerraMows knivskive har nådd det anbefalte serviceintervallet på {hours} timer. Rengjør eller bytt knivene, og tilbakestill deretter knivtidtakeren for å fjerne denne påminnelsen."
    },
    "base_station_maintenance_due": {
      "title": "Vedlikehold av TerraMow-basestasjon kreves",
