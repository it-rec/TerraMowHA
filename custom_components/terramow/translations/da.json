    },
    "schedule_write_failed": {
      "message": "Plæneklipperen accepterede ikke ændringen af planen (forsøg: {attempts}). Den nuværende TerraMow-firmware accepterer ikke skrivning af planer over det lokale netværk – producentens app bruger i stedet Bluetooth/sky. Brug blueprintet til vejrtilpasset klipning til planlægning fra Home Assistant; disse tjenester virker, når firmwaren understøtter lokal skrivning."
    }
  }
