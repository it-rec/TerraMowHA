  "issues": {
    "firmware_ha_module_too_low": {
      "title": "TerraMow-Firmware-Update erforderlich",
      "description": "Die HA-Modulversion der TerraMow-Firmware ({firmware_version}) ist zu alt für diese Integration, die Version {required_version} benötigt. Aktualisiere die Mäher-Firmware in der TerraMow-App, um den vollen Funktionsumfang wiederherzustellen."
    },
    "firmware_overall_too_low": {
      "title": "TerraMow-Firmware-Update erforderlich",
      "description": "Die TerraMow-Firmware ist älter als die mindestens unterstützte Version ({required_version}). Aktualisiere die Mäher-Firmware in der TerraMow-App, um diese Integration zu nutzen."
    },
    "firmware_incompatible": {
      "title": "TerraMow-Firmware inkompatibel",
      "description": "Die Integration konnte die Kompatibilität der TerraMow-Firmware nicht bestätigen. Prüfe, ob sowohl die Mäher-Firmware als auch diese Integration aktuell sind, lade dann die Diagnose herunter und eröffne ein Issue, falls das Problem bestehen bleibt."
    },
    "plugin_downgrade_recommended": {
      "title": "TerraMow-Integrationsupdate empfohlen",
      "description": "Die HA-Modulversion der TerraMow-Firmware ({firmware_version}) ist neuer als diese Integration unterstützt ({plugin_version}). Aktualisiere die Integration in HACS, um die neuesten Funktionen zu erhalten."
    },
    "blade_maintenance_due": {
      "title": "TerraMow-Klingenwartung fällig",
      "description": "Die Klingenscheibe des TerraMow hat das empfohlene Wartungsintervall von {hours} Stunden erreicht. Reinige oder ersetze die Klingen und setze anschließend den Klingen-Timer über die Schaltfläche „Klingen-Timer zurücksetzen“ zurück, um diese Erinnerung zu löschen."
    },
    "base_station_maintenance_due": {
      "title": "TerraMow-Basisstationswartung fällig",
      "description": "Die Basisstation des TerraMow hat das empfohlene Wartungsintervall von {days} Tagen erreicht. Reinige die Basisstation und setze anschließend den Basisstations-Timer über die Schaltfläche „Basisstations-Timer zurücksetzen“ zurück, um diese Erinnerung zu löschen."
    }
  },
  "exceptions": {
    "command_not_delivered": {
      "message": "Der Befehl konnte nicht an den Mäher gesendet werden – er ist offline oder über MQTT nicht erreichbar. Stelle sicher, dass der Mäher eingeschaltet und mit dem Netzwerk verbunden ist, und versuche es erneut."
    },
    "command_rate_limited": {
      "message": "Es wurde gerade ein anderer Befehl an den Mäher gesendet. Bitte warte einen Moment und versuche es erneut."
    },
    "command_rejected": {
      "message": "Der Mäher hat den Befehl abgelehnt (Fehlercode {code})."
    },
    "entity_not_registered": {
      "message": "{entity_id} ist keine registrierte TerraMow-Entität."
    },
    "lawn_mower_not_ready": {
      "message": "Der TerraMow-Rasenmäher für {entity_id} ist noch nicht bereit."
    },
    "schedule_item_not_found": {
      "message": "Auf dem Mäher existiert kein Zeitplan-Eintrag mit der Item-ID {item_id}."
    },
    "schedule_write_failed": {
      "message": "Der Mäher hat die Zeitplanänderung nicht übernommen (Versuche: {attempts}). Die aktuelle TerraMow-Firmware akzeptiert keine Zeitplan-Schreibzugriffe über das lokale Netzwerk - die Hersteller-App nutzt stattdessen Bluetooth/Cloud. Verwende das Blueprint \"Weather-adaptive mowing\" für Zeitpläne aus Home Assistant; diese Dienste funktionieren, sobald die Firmware lokales Schreiben unterstützt."
    }
  }
}
