    },
    "schedule_write_failed": {
      "message": "O robô corta-relva não aceitou a alteração do agendamento (tentativas: {attempts}). O firmware atual do TerraMow não aceita a escrita de agendamentos através da rede local — a aplicação do fabricante utiliza Bluetooth/nuvem. Utilize o blueprint de corte adaptado à meteorologia para agendar a partir do Home Assistant; estes serviços funcionarão assim que o firmware suportar a escrita local."
    },
    "advanced_setting_write_failed": {
      "message": "O robô não aplicou a definição {setting}. O firmware atual pode não aceitar a escrita de definições avançadas por MQTT local (tentativas: {attempts})."
