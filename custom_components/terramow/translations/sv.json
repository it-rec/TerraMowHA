    },
    "plugin_downgrade_recommended": {
      "title": "Uppdatering av TerraMow-integrationen rekommenderas",
      "description": "HA-modulversionen i TerraMow-firmwaren ({firmware_version}) är nyare än vad den här integrationen stöder ({plugin_version}). Uppdatera integrationen i HACS för att få de senaste funktionerna."
    },
    "blade_maintenance_due": {
      "title": "Underhåll av TerraMow-knivar krävs",
