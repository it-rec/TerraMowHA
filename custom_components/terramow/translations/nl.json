  "issues": {
    "firmware_ha_module_too_low": {
      "title": "Firmware-update voor TerraMow vereist",
      "description": "De HA-moduleversie in de TerraMow-firmware ({firmware_version}) is te oud voor deze integratie, die versie {required_version} vereist. Werk de firmware van de maaier bij via de TerraMow-app om de volledige functionaliteit te herstellen."
    },
    "firmware_overall_too_low": {
      "title": "Firmware-update voor TerraMow vereist",
      "description": "De TerraMow-firmware is ouder dan de minimaal ondersteunde versie ({required_version}). Werk de firmware van de maaier bij via de TerraMow-app om deze integratie te gebruiken."
    },
    "firmware_incompatible": {
      "title": "Incompatibele TerraMow-firmware",
      "description": "De integratie kon niet bevestigen dat de TerraMow-firmware compatibel is. Controleer of zowel de firmware van de maaier als deze integratie up-to-date zijn, download vervolgens de diagnostiek en open een issue als het probleem aanhoudt."
    },
    "plugin_downgrade_recommended": {
      "title": "Update van TerraMow-integratie aanbevolen",
      "description": "De HA-moduleversie in de TerraMow-firmware ({firmware_version}) is nieuwer dan deze integratie ondersteunt ({plugin_version}). Werk de integratie bij in HACS om de nieuwste functies te krijgen."
    },
    "blade_maintenance_due": {
      "title": "Onderhoud van TerraMow-messen vereist",
      "description": "De messchijf van de TerraMow heeft het aanbevolen onderhoudsinterval van {hours} uur bereikt. Reinig of vervang de messen en reset vervolgens de messentimer om deze herinnering te wissen."
    },
    "base_station_maintenance_due": {
      "title": "Onderhoud van TerraMow-basisstation vereist",
      "description": "Het basisstation van de TerraMow heeft het aanbevolen onderhoudsinterval van {days} dagen bereikt. Reinig het basisstation en reset vervolgens de basisstationtimer om deze herinnering te wissen."
    }
  },
  "exceptions": {
    "command_not_delivered": {
      "message": "Kan de opdracht niet naar de maaier sturen — deze is offline of niet bereikbaar via MQTT. Controleer of de maaier is ingeschakeld en met het netwerk is verbonden en probeer het opnieuw."
    },
    "command_rate_limited": {
      "message": "Er is zojuist een andere opdracht naar de maaier gestuurd. Wacht even en probeer het opnieuw."
    },
    "command_rejected": {
      "message": "De maaier heeft de opdracht geweigerd (foutcode {code})."
    },
    "entity_not_registered": {
      "message": "{entity_id} is geen geregistreerde TerraMow-entiteit."
    },
    "lawn_mower_not_ready": {
      "message": "De TerraMow-maaier voor {entity_id} is nog niet gereed."
    },
    "schedule_item_not_found": {
      "message": "Er bestaat geen schema-item met item id {item_id} op de maaier."
    },
    "schedule_write_failed": {
      "message": "De maaier heeft de schemawijziging niet geaccepteerd (pogingen: {attempts}). De huidige TerraMow-firmware accepteert geen schemaschrijfacties via het lokale netwerk - de app van de fabrikant gebruikt in plaats daarvan Bluetooth/cloud. Gebruik de blueprint voor weersafhankelijk maaien om vanuit Home Assistant te plannen; deze services werken zodra de firmware lokaal schrijven ondersteunt."
    },
    "advanced_setting_write_failed": {
      "message": "De maaier heeft de instelling {setting} niet toegepast. De huidige firmware accepteert mogelijk geen schrijfacties voor geavanceerde instellingen via lokale MQTT (pogingen: {attempts})."
    }
  }
